# Names only. Copy to .env (git-ignored) and fill in values locally.
POSTGRES_SUPERUSER=
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
LATHE_DB_OWNER_ROLE=
LATHE_DB_OWNER_PASSWORD=
LATHE_DB_APP_ROLE=
LATHE_DB_APP_PASSWORD=
# Auth (P1-03). Secret: at least 32 random characters.
BETTER_AUTH_SECRET=
# Password of the seeded test principals (C1 passwordEnv, must match LATHE_TEST_*PASSWORD). Test data only.
LATHE_TEST_PASSWORD=
# Apps built from templates/app-starter (P1-07). Public origin of the app; default http://localhost:3000.
LATHE_APP_BASE_URL=
