{
  "name": "lathe",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . && node scripts/check-import-boundaries.mjs",
    "test": "vitest run",
    "test:integration": "pnpm -r --if-present run test:integration",
    "format:check": "prettier --check .",
    "new-app": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/new-app.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
